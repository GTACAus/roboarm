# Fallback only, if the normal build runs short of RAM (the boot log prints
# free memory). Uses the WROVER's PSRAM without the cache-bug workaround,
# which requires an ESP32 chip revision 3 (ESP32-WROVER-E); older chips
# refuse to boot this image.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=8192
CONFIG_ESP32_REV_MIN_3=y

# The PSRAM driver needs IRAM too; give up the Wi-Fi receive fast path (the
# transmit one stays) so the image fits. Another reason PSRAM isn't the default.
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
